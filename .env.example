# Sign in with Alternate Clouds: copy to .env.local and fill in.

# 1. Create a client under Organization > Developer in the Alternate Clouds web app.
#    Type: public. Redirect URI: http://localhost:3000/api/auth/callback
#    Post-logout redirect URI (optional): http://localhost:3000/
ALTERNATE_CLOUDS_CLIENT_ID=ac_...

# 2. Only for a confidential client (leave empty for a public one).
ALTERNATE_CLOUDS_CLIENT_SECRET=

# 3. Seals the session cookie. Generate one:  openssl rand -base64 32
AUTH_SECRET=

# Optional. The issuer; default https://auth.alternatefutures.ai (use the staging issuer for a staging client).
# ALTERNATE_CLOUDS_ISSUER=https://auth.alternatefutures.ai

# Optional. When set (and registered on the client), signing out also ends the issuer session.
# ALTERNATE_CLOUDS_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
